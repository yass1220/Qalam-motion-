PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=replace_with_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_client_secret
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_TOKEN=replace_with_a_long_random_admin_token

# Optional. Railway Postgres provides this automatically when attached.
# Without DATABASE_URL, orders are stored in ./data/orders.json.
DATABASE_URL=

# Optional for local PostgreSQL without SSL.
# PGSSLMODE=disable
